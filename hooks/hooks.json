{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh idle", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh working", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh working", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh working", "timeout": 5 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh waiting", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh done", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/.agentdot/agentdot.sh idle", "timeout": 5 } ] }
    ]
  }
}
